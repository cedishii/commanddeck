        { "kind": "cmdlet", "name": "Measure-Object", "parameters": ["Property", "Sum"] }
      ],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/measure-object?view=powershell-5.1"]
