  "commands": [
    {
      "id": "ps.computer-info",
      "name": "Show computer information",
      "summary": "Detailed Windows, BIOS, hardware and locale information as properties.",
      "category": "system-info",
      "syntax": "Get-ComputerInfo",
      "aliases": ["gin"],
      "keywords": ["system information", "windows version", "bios", "hardware", "os build"],
      "tasks": ["what version of windows do i have", "show hardware info"],
      "requiresAdmin": false,
      "risk": "L1",
      "modifies": false,
      "details": {
        "expectedOutput": "A long list of properties such as WindowsProductName, OsVersion, CsManufacturer, BiosVersion.",
        "cautions": ["Takes a few seconds."]
      },
      "programs": [{ "kind": "cmdlet", "name": "Get-ComputerInfo" }],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.management/get-computerinfo?view=powershell-5.1"]
    },
    {
      "id": "ps.uptime",
      "name": "How long since the last restart",
      "summary": "Calculates how long Windows has been running since it last started.",
      "category": "system-info",
      "syntax": "(Get-Date) - (Get-CimInstance -ClassName Win32_OperatingSystem).LastBootUpTime",
      "aliases": ["uptime"],
      "keywords": ["uptime", "last boot", "boot time", "restart time"],
      "tasks": ["when did the pc last restart", "how long has the computer been on"],
      "requiresAdmin": false,
      "risk": "L1",
      "modifies": false,
      "details": {
        "syntaxParts": [
          { "part": "Get-CimInstance -ClassName Win32_OperatingSystem", "meaning": "Reads operating system information, including LastBootUpTime." },
          { "part": "(Get-Date) - …", "meaning": "Subtracting two dates gives a TimeSpan (days, hours, minutes)." }
        ],
        "expectedOutput": "A TimeSpan: Days, Hours, Minutes, Seconds and totals.",
        "cautions": ["With Fast Startup enabled, shutting down does not reset this; only a restart does.", "Windows PowerShell 5.1 has no Get-Uptime cmdlet (PowerShell 7 does)."]
      },
      "programs": [
        { "kind": "cmdlet", "name": "Get-Date" },
        { "kind": "cmdlet", "name": "Get-CimInstance", "parameters": ["ClassName"] }
      ],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/cimcmdlets/get-ciminstance?view=powershell-5.1"]
    },
    {
      "id": "ps.volumes",
