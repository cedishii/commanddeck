    {
      "id": "ps.folder-size",
      "name": "Show the size of a folder",
      "summary": "Adds up every file in a folder and its subfolders and prints the total in GB.",
      "category": "files",
      "syntax": "'{0:N2} GB' -f ((Get-ChildItem -Path \"<Folder>\" -Recurse -File -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum / 1GB)",
      "aliases": [],
      "keywords": ["folder size", "disk usage", "how big", "space used"],
      "tasks": ["how big is a folder", "find large files", "what is taking up space"],
