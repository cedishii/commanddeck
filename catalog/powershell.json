      "placeholders": [{ "name": "Pattern", "description": "File name or wildcard, e.g. *.log" }],
      "details": {
        "syntaxParts": [
          { "part": "-Path .", "meaning": "Start in the current folder." },
          { "part": "-Filter <Pattern>", "meaning": "Fast, file-system-level name filter with * and ? wildcards." }
