    {
      "id": "ps.largest-files",
      "name": "Find the largest files in Downloads",
      "summary": "Searches Downloads and its subfolders and lists the 20 biggest files with their size in MB.",
      "category": "files",
      "syntax": "Get-ChildItem -Path \"$env:USERPROFILE\\Downloads\" -Recurse -File -ErrorAction SilentlyContinue |\n    Sort-Object -Property Length -Descending |\n    Select-Object -First 20 -Property FullName, @{Name = 'SizeMB'; Expression = { [math]::Round($_.Length / 1MB, 1) }}",
      "aliases": [],
      "keywords": ["large files", "big files", "disk space", "free up space", "file size"],
      "tasks": ["find large files", "free up disk space", "what is taking up space"],
      "requiresAdmin": false,
      "risk": "L1",
      "modifies": false,
      "details": {
        "whenToUse": "Freeing up disk space. Change the -Path to search somewhere else.",
        "syntaxParts": [
          { "part": "-Recurse -File", "meaning": "Every file under the folder, including subfolders." },
          { "part": "-ErrorAction SilentlyContinue", "meaning": "Skip folders you can't read instead of printing errors." },
          { "part": "Sort-Object -Property Length -Descending", "meaning": "Biggest first." },
          { "part": "Select-Object -First 20 …", "meaning": "Keep 20 results; show the path and size in MB." }
        ]
      },
      "programs": [
        { "kind": "cmdlet", "name": "Get-ChildItem", "parameters": ["Path", "Recurse", "File", "ErrorAction"] },
        { "kind": "cmdlet", "name": "Sort-Object", "parameters": ["Property", "Descending"] },
        { "kind": "cmdlet", "name": "Select-Object", "parameters": ["First", "Property"] }
      ],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.management/get-childitem?view=powershell-5.1"]
    },
    {
