      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.management/get-process?view=powershell-5.1"]
    },
    {
      "id": "ps.top-cpu",
      "name": "Top 10 processes by CPU",
      "summary": "Shows the ten processes that have used the most CPU time.",
      "category": "services",
      "syntax": "Get-Process | Sort-Object -Property CPU -Descending | Select-Object -First 10",
      "aliases": [],
      "keywords": ["cpu", "slow computer", "high cpu", "processor usage", "resource hog"],
      "tasks": ["why is my computer slow", "what is using the cpu"],
      "requiresAdmin": false,
      "risk": "L1",
      "modifies": false,
      "details": {
        "syntaxParts": [
          { "part": "Sort-Object -Property CPU -Descending", "meaning": "Highest total CPU seconds first." },
          { "part": "Select-Object -First 10", "meaning": "Keep the first ten." }
        ],
        "cautions": ["CPU is total processor time since the process started, not current usage."]
      },
      "programs": [
        { "kind": "cmdlet", "name": "Get-Process" },
        { "kind": "cmdlet", "name": "Sort-Object", "parameters": ["Property", "Descending"] },
        { "kind": "cmdlet", "name": "Select-Object", "parameters": ["First"] }
      ],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/sort-object?view=powershell-5.1"]
    },
    {
      "id": "ps.top-memory",
      "name": "Top 10 processes by memory",
      "summary": "Shows the ten processes using the most memory, in megabytes.",
      "category": "services",
      "syntax": "Get-Process | Sort-Object -Property WorkingSet64 -Descending | Select-Object -First 10 -Property Name, Id, @{Name = 'MemoryMB'; Expression = { [math]::Round($_.WorkingSet64 / 1MB) }}",
      "aliases": [],
      "keywords": ["memory", "ram", "high memory", "slow computer", "resource hog"],
      "tasks": ["what is using my memory", "why is my computer slow"],
      "requiresAdmin": false,
      "risk": "L1",
      "modifies": false,
      "details": {
        "syntaxParts": [
          { "part": "WorkingSet64", "meaning": "Physical memory currently used by the process, in bytes." },
          { "part": "@{Name = 'MemoryMB'; Expression = { … }}", "meaning": "A calculated column converting bytes to megabytes." }
        ]
      },
      "programs": [
        { "kind": "cmdlet", "name": "Get-Process" },
        { "kind": "cmdlet", "name": "Sort-Object", "parameters": ["Property", "Descending"] },
        { "kind": "cmdlet", "name": "Select-Object", "parameters": ["First", "Property"] }
      ],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/select-object?view=powershell-5.1"]
    },
    {
      "id": "ps.stop-process",
