      "summary": "Ends every running process with the given name.",
      "category": "services",
      "syntax": "Stop-Process -Name <Name>",
      "aliases": ["kill", "spps"],
      "keywords": ["kill", "end task", "close program", "frozen", "not responding"],
      "tasks": ["close a frozen program", "kill a process"],
      "requiresAdmin": false,
      "risk": "L2",
      "modifies": true,
      "placeholders": [{ "name": "Name", "description": "Process name without .exe, e.g. notepad" }],
      "details": {
        "sideEffects": ["Unsaved work in that program is lost."],
        "cautions": ["Ends every process with that name.", "Processes of other users need administrator rights."]
      },
      "programs": [{ "kind": "cmdlet", "name": "Stop-Process", "parameters": ["Name"] }],
      "sources": ["https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.management/stop-process?view=powershell-5.1"]
    },
